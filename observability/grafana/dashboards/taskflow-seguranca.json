{
  "uid": "taskflow-seguranca",
  "title": "TaskFlow - Segurança e Login",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "taskflow",
    "runbook"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Falhas de login por IP (janela 5 min) — linha vermelha = gatilho do runbook (>10)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (client_ip) (count_over_time({job=\"taskflow\", event=\"login_failed\"} | json [5m]))",
          "queryType": "range",
          "legendFormat": "{{client_ip}}{{username}}{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "IPs acima do gatilho do runbook (>10 falhas/5 min)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (client_ip) (count_over_time({job=\"taskflow\", event=\"login_failed\"} | json [5m])) > 10",
          "queryType": "instant",
          "legendFormat": "{{client_ip}}{{username}}{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Usuários mais visados (15 min)",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(5, sum by (username) (count_over_time({job=\"taskflow\", event=\"login_failed\"} | json [15m])))",
          "queryType": "instant",
          "legendFormat": "{{client_ip}}{{username}}{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Login com sucesso por IP/usuário (15 min) — cruzar com o painel 2",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (client_ip, username) (count_over_time({job=\"taskflow\", event=\"login_success\"} | json [15m]))",
          "queryType": "instant",
          "legendFormat": "{{client_ip}}{{username}}{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Requisições por status HTTP",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({job=\"taskflow\", event=\"http_request\"} | json [1m]))",
          "queryType": "range",
          "legendFormat": "{{client_ip}}{{username}}{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Eventos de login (com request_id)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"taskflow\", event=~\"login_.*\"} | json",
          "queryType": "range",
          "legendFormat": "{{client_ip}}{{username}}{{status}}"
        }
      ]
    }
  ]
}