# Copie para .env (que está no .gitignore) e preencha. Vazio = o Compose se recusa a subir.
# Gere a chave com: python3 -c "import secrets; print(secrets.token_hex(32))"
TASKFLOW_SECRET_KEY=
# 0 em localhost (HTTP); 1 quando houver TLS na frente (cookie Secure).
TASKFLOW_HTTPS=0
GRAFANA_ADMIN_USER=admin
# Senha forte e única para o admin do Grafana.
GRAFANA_ADMIN_PASSWORD=
